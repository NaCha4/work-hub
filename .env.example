# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
# VITE_FIREBASE_* 는 비밀키가 아니라 공개 식별자다. 접근 통제는 firestore.rules 가 한다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 구글 캘린더 연동용 OAuth 클라이언트 ID. 비워두면 연동 기능만 꺼지고 나머지는 그대로 돈다.
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 의 웹 클라이언트 ID 를 넣는다.
VITE_GOOGLE_CLIENT_ID=
