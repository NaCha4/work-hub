rules_version = '2';

// Work Hub 접근 통제
//  - 로그인하지 않은 사람은 아무것도 읽거나 쓸 수 없다. 단 하나의 예외가 발표 세션이다.
//  - isAllowedIdentity() 에 적힌 계정만 members 문서를 만들 수 있다 (= 최초 가입).
//  - members 문서가 있는 사람만 일지/할일/회의록/준비자료에 접근할 수 있다.
//  - 발표 세션(sessions)은 코드를 아는 사람이면 로그인 없이 문서 "하나" 만 읽을 수 있다.
//    코드가 곧 문서 ID 이고 목록 조회(list)는 멤버만 가능하므로, 코드를 모르면
//    어떤 세션이 존재하는지조차 알 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedIdentity() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['name@example.com', 'name@example.com'];
    }

    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isOwner() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'owner';
    }

    match /members/{uid} {
      allow read: if isMember();
      // 본인 문서만, 허용된 신원으로만, role 은 member 로 고정해 생성.
      allow create: if isAllowedIdentity()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member';
      // 본인 프로필은 수정 가능하되 권한 승격은 불가. 권한 변경은 owner 만.
      allow update: if (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role)
                    || isOwner();
      allow delete: if isOwner();
    }

    match /journals/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isOwner());
    }

    match /meetings/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
      // 회의록은 참석자 누구나 이어서 정리할 수 있게 멤버 전체에 수정 허용.
      allow update: if isMember();
      allow delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isOwner());
    }

    match /preps/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isMember();
      allow delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isOwner());
    }

    // 할 일은 팀 공용 보드로 쓰므로 멤버 전체가 읽고 쓴다.
    match /tasks/{id} {
      allow read, create, update, delete: if isMember();
    }

    // 발표 세션 — 이 앱에서 유일하게 비로그인 접근을 허용하는 곳.
    // 문서 ID 가 곧 세션 코드다. get 은 ID 를 정확히 알아야만 성공하고,
    // list 는 멤버만 되므로 코드를 모르는 사람은 목록을 훑을 수 없다.
    match /sessions/{code} {
      allow get: if isMember()
        || (resource.data.active == true
            && resource.data.expiresAt > request.time.toMillis());
      allow list: if isMember();
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isMember()
        && (resource.data.createdBy == request.auth.uid || isOwner());
    }

    // 위에서 명시하지 않은 모든 경로는 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
