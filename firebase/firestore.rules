rules_version = '2';

// Work Hub 접근 통제
//  - 로그인하지 않은 사람은 아무것도 읽거나 쓸 수 없다. 단 하나의 예외가 발표 세션이다.
//  - 허용 목록에 있는 계정만 members 문서를 만들 수 있다 (= 최초 가입).
//    목록은 이 파일이 아니라 Firestore 의 config/access 문서에 있다.
//    저장소가 공개라서 계정 정보를 코드에 남기지 않으려는 것이고,
//    계정을 추가·삭제할 때 규칙을 다시 배포하지 않아도 되는 이점도 있다.
//  - members 문서가 있는 사람만 일지/할일/회의메모/준비자료/식사기록에 접근할 수 있다.
//  - 발표 세션(sessions)은 코드를 아는 사람이면 로그인 없이 문서 "하나" 만 읽을 수 있다.
//    코드가 곧 문서 ID 이고 목록 조회(list)는 멤버만 가능하므로, 코드를 모르면
//    어떤 세션이 존재하는지조차 알 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 허용 목록. config/access 문서가 없으면 아무도 가입하지 못한다(= 안전한 기본값).
    // 규칙 안의 get() 은 클라이언트 읽기 권한을 우회하므로, 아직 멤버가 아닌 사람이
    // 그 문서를 읽지 못해도 이 검사는 정상 동작한다.
    function allowedEmails() {
      return exists(/databases/$(database)/documents/config/access)
        ? get(/databases/$(database)/documents/config/access).data.emails
        : [];
    }

    function isAllowedIdentity() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in allowedEmails();
    }

    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isOwner() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'owner';
    }

    match /members/{uid} {
      // 본인 문서는 멤버가 아니어도 읽을 수 있어야 한다.
      // 클라이언트가 "내 멤버 문서가 있나?" 를 먼저 확인한 뒤 없으면 만드는데,
      // 이걸 isMember() 로 막으면 멤버가 되려면 이미 멤버여야 하는 교착이 된다.
      // 없는 문서를 읽으면 빈 결과가 올 뿐이라 새어 나가는 정보는 없다.
      allow get: if isSignedIn() && (request.auth.uid == uid || isMember());
      allow list: if isMember();
      // 본인 문서만, 허용된 신원으로만, role 은 member 로 고정해 생성.
      allow create: if isAllowedIdentity()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member';
      // 본인 프로필은 수정 가능하되 권한 승격은 불가. 권한 변경은 owner 만.
      allow update: if (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role)
                    || isOwner();
      allow delete: if isOwner();
    }

    match /journals/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
      // 일지는 하나의 작업 공간을 함께 보므로 어느 허용 계정에서 작성했든 고칠 수 있다.
      allow update, delete: if isMember();
    }

    match /meetings/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
      // 회의록은 참석자 누구나 이어서 정리할 수 있게 멤버 전체에 수정 허용.
      allow update: if isMember();
      allow delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isOwner());
    }

    match /preps/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isMember();
      allow delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isOwner());
    }

    // 할 일은 팀 공용 보드로 쓰므로 멤버 전체가 읽고 쓴다.
    match /tasks/{id} {
      allow read, create, update, delete: if isMember();
    }

    // 식사 기록. 업무 자료는 아니지만 접근 조건은 나머지와 같다.
    match /meals/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isOwner());
    }

    // 발표 세션 — 이 앱에서 유일하게 비로그인 접근을 허용하는 곳.
    // 문서 ID 가 곧 세션 코드다. get 은 ID 를 정확히 알아야만 성공하고,
    // list 는 멤버만 되므로 코드를 모르는 사람은 목록을 훑을 수 없다.
    match /sessions/{code} {
      allow get: if isMember()
        || (resource.data.active == true
            && resource.data.expiresAt > request.time.toMillis());
      allow list: if isMember();
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isMember()
        && (resource.data.createdBy == request.auth.uid || isOwner());
    }

    // 허용 계정 목록. 멤버만 읽고 고칠 수 있다.
    // 비멤버에게는 존재조차 보이지 않지만, 위 allowedEmails() 의 get() 은
    // 규칙 실행 컨텍스트라 이 제한과 무관하게 값을 읽는다.
    match /config/{doc} {
      allow read, write: if isMember();
    }

    // 위에서 명시하지 않은 모든 경로는 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
